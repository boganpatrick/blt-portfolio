# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite db (dev only — production reads from Turso)
dev.db
dev.db-shm
dev.db-wal
dev.db-journal

# scratch dir used by ci/validate_data.ts (regression test / data
# validation script) — always regenerated, never meant to be committed
.validate-scratch

# Raw source documents (closing statements, ALTA settlements, QuickBooks
# exports, VARE underwriting files, PM statements) and one-off deliverables
# built from them — Patrick's confidential financial/legal documents, used
# only locally by the one-off import/seed scripts to populate Turso. Never
# push these to GitHub.
data/raw
data/processed
deliverables

# GitHub Actions CI workflow — written locally but NOT yet in the remote
# repo. The GitHub PAT configured for this project lacks the `workflow`
# OAuth scope, so any push including this file is rejected outright by
# GitHub ("refusing to allow a Personal Access Token to create or update
# workflow ... without workflow scope"). It's gitignored here only so it
# stops showing as an untracked file / tripping the pre-commit check.
# To actually enable it: either (a) generate a PAT with the workflow
# scope and remove this ignore rule, then commit+push normally, or
# (b) add .github/workflows/ci.yml manually via the GitHub web UI using
# the version already sitting on disk. Once it's actually in the repo,
# remove this ignore entry.
.github/workflows/ci.yml
